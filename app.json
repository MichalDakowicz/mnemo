{
  "expo": {
    "name": "Mnemo",
    "slug": "mnemo",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mnemo",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0b",
    "android": {
      "package": "com.michaldakowicz.mnemo",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a0b"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
